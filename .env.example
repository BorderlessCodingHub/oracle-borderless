# --- Ambiente ---
ENVIRONMENT=development
DEBUG=true
ENABLE_SCHEDULER=true

# --- Autenticação (ADR-0017/0018) ---
# Login é público e o token da plataforma é opaco: nenhum segredo necessário.
BORDERLESS_AUTH_URL=https://api.borderlesscoding.com
ADMIN_EMAILS=

# --- Navegação (agente) ---
# NAVIGATION_CATALOG_TTL_S=3600
# Cache negativo: quanto esperar antes de tentar a API de novo depois de uma falha.
# NAVIGATION_CATALOG_RETRY_S=60
# NAVIGATION_TIMEOUT_SECONDS=8.0

# --- CORS ---
# Vazio = SPA e API no mesmo host (proxy do Vite em dev), sem CORSMiddleware.
# Preencher só se o SPA ficar num host distinto da API (separado por vírgula).
CORS_ORIGINS=

# --- Banco (defaults do docker-compose) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=oracle
DB_PASSWORD=oracle
DB_NAME=oracle_borderless
DB_NAME_TEST=oracle_borderless_test

# --- LLM do oráculo ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=            # preencher
ANTHROPIC_MODEL=claude-opus-4-8
# OPENAI_MODEL=gpt-4o         # se LLM_PROVIDER=openai

# --- Embeddings (OpenAI; necessário mesmo usando Claude no chat) ---
OPENAI_API_KEY=               # preencher

# --- Base de conhecimento: Notion via MCP (token JÁ disponível; preencher no final) ---
NOTION_MCP_URL=               # preencher
NOTION_MCP_TOKEN=             # preencher
# Escopo da KB: NÃO se configura aqui (ADR-0015). A base é o que a integração
# do Notion enxerga — para incluir ou excluir conteúdo, mude o compartilhamento
# no Notion. `python cli.py knowledge:roots` mostra o que está em consumo.
# NOTION_KB_ROOT_PAGE_IDS e NOTION_KB_ROOT_PAGE_ID derrubam o boot se definidas.

# --- Web search ---
TAVILY_API_KEY=               # preencher

# --- RAG ---
RAG_TOP_K=6
# Distância cosseno máxima para um trecho ser considerado relevante (0..2).
# Acima disso o oráculo responde que não encontrou. Default: 0.55
RAG_MAX_DISTANCE=0.55
RAG_CHUNK_SIZE=1500
RAG_CHUNK_OVERLAP=200

# --- Eval (judge) ---
# Onde o harness de eval grava os reports (lidos pela página /ops)
EVAL_REPORTS_DIR=evals/reports
# O juiz é sempre OpenAI, independente de LLM_PROVIDER (ADR-0013 / spec 2026-08-03).
# JUDGE_MODEL=gpt-4.1-mini

# --- Tracing: LangSmith (opcional; desligado por padrão) ---
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=           # preencher, só se LANGSMITH_TRACING=true
LANGSMITH_PROJECT=oracle-borderless
# LANGSMITH_PROJECT_URL=       # preencher com a URL base do projeto no LangSmith
